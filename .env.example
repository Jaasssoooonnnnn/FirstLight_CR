# Copy .env.example to .env and fill the settings needed by your workflow.
# 复制为 .env，按所用工作流填写配置。
# UTF-8 KEY=value. Optional matching quotes; no variable expansion.
# 使用 UTF-8 KEY=value，可加成对引号，不展开变量。
# Existing process environment overrides this file. Blank values are unset.
# 已有进程环境变量优先；空值视为未设置。
# Use absolute paths for external resources. This file is local to each host.
# 外部资源填写绝对路径；每台主机单独配置。

# Python (desktop Python must include Tkinter)
# Python（桌面解释器须包含 Tkinter）
CR_PYTHON=
CR_PYTHONW=

# Optional advanced overrides. Leave blank for the shipped models/data.
# 可选高级覆盖；使用随附模型和数据时留空。
CR_WORKSPACE_ROOT=
CR_COMPETITIVE_DATA_ROOT=
CR_REPLAY_DATASET_ROOT=

# Windows offline VM (explicit dedicated instance)
# Windows 离线 VM（明确指定专用实例）
CR_MUMU_MANAGER=
CR_ADB=
CR_VM_INDEX=
CR_VM_NAME=
CR_ADB_SERIAL=
CR_CONTROL_HOST=
CR_CONTROL_PORT=
CR_GUEST_CONTROL_PORT=
CR_OVERLAY_PROCESS=
CR_ENGINE_COUNT=
CR_SLOTS_PER_ENGINE=
CR_VM_MEMORY_GB=
CR_CONFIGURE_VM_RESOURCES=
CR_HOST_CPU_AFFINITY=
CR_EXPECTED_APK_SHA256=

# Android build tools and outputs
# Android 构建工具与输出
CR_INPUT_APK=
CR_DECODED_APK=
CR_JAVA=
CR_KEYTOOL=
CR_BUILD_TOOLS=
CR_NDK_ROOT=
CR_BUILD_ENGINE_COUNT=
CR_PROBE=
CR_OUTPUT_APK=

# Linux training resources (fill for the deployment host)
# Linux 训练资源（按部署主机填写）
CR_AI_ROOT=
CR_AI_PYTHON=
CR_TRAINING_ADB=
CR_TRAINING_SDK_ROOT=
CR_EMULATOR=
CR_SOURCE_AVD=
CR_SOURCE_AVD_INI=
# Standalone userdata image of a prepared offline AVD, not stock SDK userdata.
# 已准备离线 AVD 的独立 userdata 镜像，不使用 SDK 空白镜像。
CR_EMULATOR_INITDATA=
CR_TRAINING_APK=
CR_EMULATOR_COMPAT=
CR_EMULATOR_DNS=
CR_PPO_PROBE=
CR_PPO_ENGINE_CONFIGURATOR=

# Training launcher settings (CLI arguments can override a run)
# 训练启动参数（命令行可覆盖单次运行配置）
IL_WORLD_SIZE=
CR_IL_SHARDS_PER_RANK=
CR_IL_TORCH_THREADS=
CR_IL_SAVE_EVERY_GROUPS=
CR_PPO_ENGINE_COUNT=
CR_PPO_BASE_PORT=
CR_EMULATOR_BASE_PORT=
CR_PPO_ENGINES_PER_GUEST=
CR_PPO_GUEST_MEMORY_MB_PER_ENGINE=
CR_PPO_REMOTE_WORKER_PORT=
CR_PPO_CPU_OFFSET=
CR_PPO_TRIM_GUEST_APPS=
CR_PPO_CONFIGURE_GUEST_BATCH=
CR_PPO_DECK_POOL=
CR_PPO_CHECKPOINT=
CR_PPO_TOPOLOGY=
CR_PPO_OUTPUT_DIR=
CR_PPO_RESUME_CHECKPOINT=
CR_PPO_UPDATES=
CR_PPO_SEGMENT_SECONDS=
CR_PPO_TIMEOUT=
CR_PPO_EPOCHS=
CR_PPO_LANE_MINIBATCH_SIZE=
CR_PPO_LANE_MICROBATCH_SIZE=
CR_PPO_SEQUENCE_CHUNK_STEPS=
CR_PPO_SEED=
